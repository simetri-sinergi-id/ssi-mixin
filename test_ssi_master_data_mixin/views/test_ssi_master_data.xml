<odoo>
    <!-- Search View -->
    <record id="test_ssi_master_data_view_search" model="ir.ui.view">
        <field name="name">test_ssi_master_data - search</field>
        <field name="model">test_ssi_master_data</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="before">
                    <field name="id" />
                </xpath>
            </data>
        </field>
    </record>

    <!-- Tree View -->
    <record id="test_ssi_master_data_view_tree" model="ir.ui.view">
        <field name="name">test_ssi_master_data - tree</field>
        <field name="model">test_ssi_master_data</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="before">
                    <field name="id" />
                </xpath>
            </data>
        </field>
    </record>

    <!-- Form View -->
    <record id="test_ssi_master_data_view_form" model="ir.ui.view">
        <field name="name">test_ssi_master_data - form</field>
        <field name="model">test_ssi_master_data</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <!-- Action -->
    <record id="test_ssi_master_data_action" model="ir.actions.act_window">
        <field name="name">Test SSI Master Data</field>
        <field name="res_model">test_ssi_master_data</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="test_ssi_master_data_menu"
        name="Test Master Data Mixin"
        parent="test_master_data_mixin_menu"
        action="test_ssi_master_data_action"
        sequence="10"
    />
</odoo>
